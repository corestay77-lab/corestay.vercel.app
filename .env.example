# Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Email notification (Resend) — dikirim otomatis setiap kali user
# menyelesaikan assessment (existing hotel & pre-opening).
# 1. Buat akun di https://resend.com dan ambil API key-nya.
# 2. Untuk mengirim dari alamat kustom (mis. no-reply@corestayadvisory.com),
#    verifikasi domain tersebut di dashboard Resend, lalu isi ASSESSMENT_FROM_EMAIL.
#    Jika belum verifikasi domain, gunakan default "onboarding@resend.dev"
#    (hanya bisa mengirim ke email pemilik akun Resend).
RESEND_API_KEY=your-resend-api-key
ASSESSMENT_NOTIFY_EMAIL=admin@corestayadvisory.com
ASSESSMENT_FROM_EMAIL=Core Stay_Advisory <onboarding@resend.dev>
